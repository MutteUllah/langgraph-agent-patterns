# Gemini Developer API credentials. Keep real values only in an ignored .env.
GEMINI_API_KEY=
# Choose a chat model available to your account that supports tools/structured output.
GEMINI_CHAT_MODEL=
# Needed by project.py only; choose a compatible embedding model.
GEMINI_EMBEDDING_MODEL=
# Match the embedding model output dimensions. The original example used 3072.
GEMINI_EMBEDDING_DIMENSIONS=3072
